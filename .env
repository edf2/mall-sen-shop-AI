# API Key
DASHSCOPE_API_KEY=sk-6e2193cbb51d454baf179ad03f4f32f1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Java 后端地址（Python Agent 通过该地址调用 Java Business AI API）
JAVA_BACKEND_URL=http://localhost:8080
# Agent 与 Java 后端共用的共享密钥，需与 Java 端 agent.service.api-key（环境变量 AGENT_API_KEY）一致。
# 商家 AI 调用 Java 时以 x-agent-key 请求头鉴权（不设过期时间，替代此前 8 天即失效的 ADMIN_JWT_TOKEN）。
AGENT_API_KEY=change-me

# Redis（对话记忆持久化，默认 redis://localhost:6379/0）
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=2592000