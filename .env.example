# 环境变量示例文件（复制为 .env 后按需修改）
# cp .env.example .env

# 阿里云 DashScope API Key（到阿里云 DashScope 控制台获取）
DASHSCOPE_API_KEY=<你的DashScope API Key>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Java 后端地址（Python Agent 通过该地址调用 Java Business AI API）
JAVA_BACKEND_URL=http://localhost:8080

# Agent 与 Java 后端共用的共享密钥，需与 Java 端 AGENT_API_KEY 一致
AGENT_API_KEY=<生成 32 位以上强随机串>

# Redis（对话记忆持久化）
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=2592000
